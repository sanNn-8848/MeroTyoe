<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_keyboard_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@drawable/bg_keyboard_container_dark">

    <android.widget.ImageView
        android:id="@+id/frost_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_glow_dark"
        android:contentDescription="@null" />

    <android.widget.ImageView
        android:id="@+id/frost_mountains"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:scaleType="fitXY"
        android:src="@drawable/bg_mountains_dark"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- Feature Carousel Strip -->
        <com.romannepali.keyboard.FeatureCarouselView
            android:id="@+id/feature_carousel"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/bg_prediction_bar" />

        <!-- Feature Content Pane (suggestions / clipboard / emoji) -->
        <FrameLayout
            android:id="@+id/feature_pane"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="@drawable/bg_prediction_bar">

            <!-- Container for Compose SuggestionView -->
            <LinearLayout
                android:id="@+id/container_suggestions"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />

            <com.romannepali.keyboard.SuggestionBar
                android:id="@+id/suggestion_bar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Keyboard -->
        <com.romannepali.keyboard.GboardKeyboardView
            android:id="@+id/keyboard_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent" />
    </LinearLayout>

</FrameLayout>
